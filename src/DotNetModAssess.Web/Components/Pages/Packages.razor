@page "/packages"
@using DotNetModAssess.Core.PackageCompatibility
@inject SolutionStateService State
@inject INuGetCompatibilityChecker Checker
@implements IDisposable

<PageTitle>Packages</PageTitle>

<h1>Packages</h1>

@if (State.Solution is null)
{
    <p class="text-muted">No solution loaded yet. <a href="/">Go load one</a>.</p>
}
else
{
    <p class="text-muted">
        Every distinct package referenced anywhere in the loaded solution, in one place - which
        version(s) each project uses, whether that's a version conflict, and how much the
        solution's own source actually uses it (see the Packages tab on a project's page for the
        same usage-confidence breakdown, per-project). Compatibility with
        <code>@TargetFrameworkMoniker</code> is checked on demand, not eagerly, since it's a real
        network call against the solution's configured NuGet sources per package.
    </p>

    @if (_packages.Count == 0)
    {
        <p class="text-muted">No packages found across the loaded solution.</p>
    }
    else
    {
        <button class="btn btn-primary mb-3" @onclick="CheckAllAsync" disabled="@_isCheckingAll">
            @(_isCheckingAll ? $"Checking all... ({_checking.Count} in flight)" : "Check all")
        </button>

        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Package</th>
                    <th>Version(s) in use</th>
                    <th>Conflict</th>
                    <th>Usages</th>
                    <th>Compatibility (@TargetFrameworkMoniker)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _packages)
                {
                    var (confirmedUsages, possibleUsages, speculativeUsages) = CountUsagesByConfidence(row.PackageId);
                    var hasResult = _results.TryGetValue(row.PackageId, out var info) && info!.CurrentVersion == row.PrimaryVersion;
                    var isChecking = _checking.Contains(row.PackageId);
                    <tr>
                        <td>@row.PackageId</td>
                        <td>
                            @foreach (var versionGroup in row.ProjectVersions.GroupBy(v => v.Version))
                            {
                                <div>
                                    <code>@(string.IsNullOrEmpty(versionGroup.Key) ? "(unresolved)" : versionGroup.Key)</code>
                                    <span class="text-muted small">(@string.Join(", ", versionGroup.Select(v => ProjectName(v.ProjectPath))))</span>
                                </div>
                            }
                        </td>
                        <td>
                            @if (row.HasVersionConflict)
                            {
                                <span class="badge bg-danger" title="@string.Join(", ", row.ProjectVersions.Select(v => $"{v.ProjectPath}: {v.Version}"))">
                                    Conflict (@string.Join(", ", row.ProjectVersions.Select(v => v.Version).Distinct()))
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (confirmedUsages == 0 && possibleUsages == 0 && speculativeUsages == 0)
                            {
                                <span class="text-muted">0</span>
                            }
                            else
                            {
                                @if (confirmedUsages > 0)
                                {
                                    <span class="badge bg-success me-1" title="Confirmed by Roslyn syntax analysis">@confirmedUsages confirmed</span>
                                }
                                @if (possibleUsages > 0)
                                {
                                    <span class="badge bg-warning text-dark me-1" title="Text match only - not confirmed by Roslyn syntax analysis">@possibleUsages possible</span>
                                }
                                @if (speculativeUsages > 0)
                                {
                                    <span class="badge border border-secondary text-secondary" title="Harvested partial match - high false-positive risk, verify manually">@speculativeUsages speculative</span>
                                }
                            }
                        </td>
                        <td>
                            @if (isChecking)
                            {
                                <span class="text-muted">Checking...</span>
                            }
                            else if (hasResult)
                            {
                                @if (!info!.CheckSucceeded)
                                {
                                    <span class="badge bg-secondary" title="@info.ErrorMessage">&#10060; Check failed</span>
                                    @if (info.ErrorMessage is not null)
                                    {
                                        <div class="text-muted small">@info.ErrorMessage</div>
                                    }
                                }
                                else if (info.CurrentVersionIsCompatible)
                                {
                                    <span class="badge bg-success">&#9989; Compatible</span>
                                }
                                else if (info.RecommendedUpgradeVersion is not null)
                                {
                                    <span class="badge bg-warning text-dark">&#9888; Upgrade to @info.RecommendedUpgradeVersion</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger" title="@("Latest published version: " + (info.LatestPublishedVersion ?? "unknown"))">
                                        &#9888; No compatible version published yet
                                    </span>
                                }
                                <div class="text-muted small">checked v@(info.CurrentVersion)</div>
                            }
                            else
                            {
                                <span class="text-muted">Not checked</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => CheckOneAsync(row)" disabled="@(isChecking || _isCheckingAll || string.IsNullOrEmpty(row.PrimaryVersion))">
                                Check compatibility
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private const string TargetFrameworkMoniker = "net8.0";
    private const int MaxConcurrentChecks = 10;

    private List<PackageRow> _packages = [];
    private Dictionary<string, string> _projectNames = new();
    private readonly Dictionary<string, PackageCompatibilityInfo> _results = new();
    private readonly HashSet<string> _checking = new();
    private bool _isCheckingAll;
    private readonly CancellationTokenSource _cts = new();

    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        RebuildPackages();
    }

    private void OnStateChanged() =>
        InvokeAsync(() =>
        {
            RebuildPackages();
            StateHasChanged();
        });

    private void RebuildPackages()
    {
        if (State.Solution is null || State.Graph is null)
        {
            _packages = [];
            _projectNames = new();
            return;
        }

        _projectNames = State.Solution.Projects.ToDictionary(p => p.Path, p => p.Name);

        _packages = State.Graph.Nodes
            .OfType<PackageGraphNode>()
            .Select(n => new PackageRow(n.Package.PackageId, n.Package.ProjectVersions, n.Package.HasVersionConflict))
            .OrderBy(p => p.PackageId, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private string ProjectName(string projectPath) => _projectNames.GetValueOrDefault(projectPath, projectPath);

    private (int Confirmed, int Possible, int Speculative) CountUsagesByConfidence(string packageId)
    {
        var matches = (State.UsageResults ?? []).Where(u => u.TargetName == packageId).ToList();
        return (
            matches.Count(u => u.Confidence == UsageConfidence.Confirmed),
            matches.Count(u => u.Confidence == UsageConfidence.TextMatch),
            matches.Count(u => u.Confidence == UsageConfidence.SuffixMatch));
    }

    private string SolutionRootDirectory =>
        State.Solution is null ? string.Empty : Path.GetDirectoryName(State.Solution.Path) ?? string.Empty;

    private async Task CheckOneAsync(PackageRow row)
    {
        if (State.Solution is null || _checking.Contains(row.PackageId) || _isCheckingAll)
        {
            return;
        }

        await CheckOneCoreAsync(row, SolutionRootDirectory, _cts.Token);
        StateHasChanged();
    }

    private async Task CheckAllAsync()
    {
        if (State.Solution is null || _isCheckingAll)
        {
            return;
        }

        _isCheckingAll = true;
        StateHasChanged();

        var solutionRoot = SolutionRootDirectory;
        var token = _cts.Token;

        try
        {
            using var semaphore = new SemaphoreSlim(MaxConcurrentChecks);

            var tasks = _packages.Select(async row =>
            {
                await semaphore.WaitAsync(token);
                try
                {
                    await CheckOneCoreAsync(row, solutionRoot, token);
                    await InvokeAsync(StateHasChanged);
                }
                finally
                {
                    semaphore.Release();
                }
            });

            await Task.WhenAll(tasks);
        }
        catch (OperationCanceledException)
        {
            // Page navigated away / disposed mid-run - nothing left to show.
        }
        finally
        {
            _isCheckingAll = false;
            StateHasChanged();
        }
    }

    private async Task CheckOneCoreAsync(PackageRow row, string solutionRoot, CancellationToken cancellationToken)
    {
        if (string.IsNullOrEmpty(row.PrimaryVersion))
        {
            return;
        }

        _checking.Add(row.PackageId);

        try
        {
            var result = await Checker.CheckAsync(solutionRoot, row.PackageId, row.PrimaryVersion, TargetFrameworkMoniker, cancellationToken);
            _results[row.PackageId] = result;
        }
        catch (OperationCanceledException)
        {
            // Page navigated away / disposed mid-check - drop silently.
        }
        finally
        {
            _checking.Remove(row.PackageId);
        }
    }

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        _cts.Cancel();
        _cts.Dispose();
    }

    private sealed record PackageRow(string PackageId, IReadOnlyList<PackageProjectVersion> ProjectVersions, bool HasVersionConflict)
    {
        /// <summary>The version this row's "Check compatibility" button checks: the version used
        /// by the alphabetically-first project referencing this package, for a deterministic
        /// choice when <see cref="HasVersionConflict"/> is true (there's no single "the" version
        /// in that case - see the Conflict badge for the full per-project breakdown).</summary>
        public string? PrimaryVersion => ProjectVersions
            .OrderBy(v => v.ProjectPath, StringComparer.OrdinalIgnoreCase)
            .Select(v => v.Version)
            .FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));
    }
}
