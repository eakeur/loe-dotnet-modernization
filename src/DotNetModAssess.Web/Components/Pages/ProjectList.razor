@page "/projects"
@inject SolutionStateService State

<PageTitle>Projects</PageTitle>

<h1>Projects</h1>

@if (State.Solution is null)
{
    <p class="text-muted">No solution loaded yet. <a href="/">Go load one</a>.</p>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <input class="form-control" placeholder="Search by name or path..." @bind="_search" @bind:event="oninput" />
        </div>
        <div class="col-md-4">
            <select class="form-select" @bind="_formatFilter">
                <option value="">Any format</option>
                <option value="SdkStyle">SDK-style</option>
                <option value="LegacyStyle">Legacy-style</option>
            </select>
        </div>
        <div class="col-md-4">
            <select class="form-select" @bind="_packagesModelFilter">
                <option value="">Any packages model</option>
                <option value="PackageReference">PackageReference</option>
                <option value="PackagesConfig">packages.config</option>
                <option value="None">None</option>
            </select>
        </div>
    </div>

    <div class="mb-3 d-flex flex-wrap gap-3">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="flt-web" @bind="_onlySystemWeb" />
            <label class="form-check-label" for="flt-web">References System.Web</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="flt-svcmodel" @bind="_onlySystemServiceModel" />
            <label class="form-check-label" for="flt-svcmodel">References System.ServiceModel</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="flt-com" @bind="_onlyComReferences" />
            <label class="form-check-label" for="flt-com">Has COM references</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="flt-appconfig" @bind="_onlyAppConfig" />
            <label class="form-check-label" for="flt-appconfig">Has app.config</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="flt-cm" @bind="_onlyConfigurationManager" />
            <label class="form-check-label" for="flt-cm">Uses ConfigurationManager</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="flt-diag" @bind="_onlyWithDiagnostics" />
            <label class="form-check-label" for="flt-diag">Has evaluation diagnostics</label>
        </div>
    </div>

    var filtered = GetFilteredAndSortedProjects();

    <p class="text-muted">Showing @filtered.Count of @State.Solution.Projects.Count projects.</p>

    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th role="button" @onclick='() => SetSort("Name")'>Name @SortIndicator("Name")</th>
                <th>Path</th>
                <th role="button" @onclick='() => SetSort("Format")'>Format @SortIndicator("Format")</th>
                <th role="button" @onclick='() => SetSort("Tfm")'>Target Framework @SortIndicator("Tfm")</th>
                <th>Packages model</th>
                <th>Legacy signals</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var project in filtered)
            {
                <tr style="cursor:pointer" @onclick="() => GoToDetail(project)">
                    <td>@project.Name</td>
                    <td><code>@project.Path</code></td>
                    <td>
                        <span class="badge @(project.Format == ProjectFormat.LegacyStyle ? "bg-warning text-dark" : "bg-success")">
                            @project.Format
                        </span>
                    </td>
                    <td>@project.Metadata.TargetFrameworkRaw</td>
                    <td>@project.Metadata.PackagesModel</td>
                    <td>
                        @if (project.Metadata.LegacySignals.ReferencesSystemWeb)
                        {
                            <span class="badge bg-secondary me-1">System.Web</span>
                        }
                        @if (project.Metadata.LegacySignals.ReferencesSystemServiceModel)
                        {
                            <span class="badge bg-secondary me-1">System.ServiceModel</span>
                        }
                        @if (project.Metadata.LegacySignals.ComReferences.Count > 0)
                        {
                            <span class="badge bg-secondary me-1">COM</span>
                        }
                        @if (project.Metadata.Diagnostics.Count > 0)
                        {
                            <span class="badge bg-danger me-1">@project.Metadata.Diagnostics.Count diagnostic(s)</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string _search = "";
    private string _formatFilter = "";
    private string _packagesModelFilter = "";
    private bool _onlySystemWeb;
    private bool _onlySystemServiceModel;
    private bool _onlyComReferences;
    private bool _onlyAppConfig;
    private bool _onlyConfigurationManager;
    private bool _onlyWithDiagnostics;

    private string _sortColumn = "Name";
    private bool _sortAscending = true;

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string SortIndicator(string column) =>
        _sortColumn != column ? "" : (_sortAscending ? "▲" : "▼");

    private List<ProjectModel> GetFilteredAndSortedProjects()
    {
        IEnumerable<ProjectModel> query = State.Solution!.Projects;

        if (!string.IsNullOrWhiteSpace(_search))
        {
            query = query.Where(p =>
                p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                p.Path.Contains(_search, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrEmpty(_formatFilter) && Enum.TryParse<ProjectFormat>(_formatFilter, out var format))
        {
            query = query.Where(p => p.Format == format);
        }

        if (!string.IsNullOrEmpty(_packagesModelFilter) && Enum.TryParse<PackagesModel>(_packagesModelFilter, out var packagesModel))
        {
            query = query.Where(p => p.Metadata.PackagesModel == packagesModel);
        }

        if (_onlySystemWeb)
        {
            query = query.Where(p => p.Metadata.LegacySignals.ReferencesSystemWeb);
        }

        if (_onlySystemServiceModel)
        {
            query = query.Where(p => p.Metadata.LegacySignals.ReferencesSystemServiceModel);
        }

        if (_onlyComReferences)
        {
            query = query.Where(p => p.Metadata.LegacySignals.ComReferences.Count > 0);
        }

        if (_onlyAppConfig)
        {
            query = query.Where(p => p.Metadata.LegacySignals.HasAppConfig);
        }

        if (_onlyConfigurationManager)
        {
            query = query.Where(p => p.Metadata.LegacySignals.UsesConfigurationManager);
        }

        if (_onlyWithDiagnostics)
        {
            query = query.Where(p => p.Metadata.Diagnostics.Count > 0);
        }

        query = _sortColumn switch
        {
            "Format" => _sortAscending ? query.OrderBy(p => p.Format) : query.OrderByDescending(p => p.Format),
            "Tfm" => _sortAscending ? query.OrderBy(p => p.Metadata.TargetFrameworkRaw) : query.OrderByDescending(p => p.Metadata.TargetFrameworkRaw),
            _ => _sortAscending ? query.OrderBy(p => p.Name) : query.OrderByDescending(p => p.Name)
        };

        return query.ToList();
    }

    private void GoToDetail(ProjectModel project) =>
        Nav.NavigateTo($"/projects/{project.Path}");

    [Inject]
    private NavigationManager Nav { get; set; } = default!;
}
