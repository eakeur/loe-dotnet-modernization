@page "/"
@inject SolutionStateService State
@implements IDisposable

<PageTitle>Solution Overview</PageTitle>

<h1>Solution Overview</h1>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Load a solution</h5>
        <p class="text-muted">
            Enter the path to a <code>.sln</code> or <code>.slnf</code> file. Try the bundled
            sample fixture at <code>fixtures/SampleLegacySolution/SampleLegacySolution.sln</code>
            (repo-root-relative) to see a mixed legacy/SDK-style solution end to end.
        </p>
        <div class="input-group" style="max-width: 640px;">
            <input class="form-control" placeholder="e.g. C:\src\MyApp\MyApp.sln"
                   @bind="_solutionPath" @bind:event="oninput" disabled="@State.IsLoading" />
            <button class="btn btn-primary" @onclick="LoadAsync" disabled="@State.IsLoading">
                @(State.IsLoading ? "Loading..." : "Load solution")
            </button>
        </div>
        @if (State.IsLoading)
        {
            <div class="mt-2 text-muted">
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                @State.LoadingStageMessage
            </div>
        }
        @if (State.LastError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">Failed to load: @State.LastError</div>
        }
        @if (State.IsWatching)
        {
            <div class="mt-2 small text-success">
                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">● Live</span>
                Watching this solution's files for changes - editing a .csproj or Directory.Packages.props
                triggers an automatic re-scan.
            </div>
        }
    </div>
</div>

@if (State.Solution is null)
{
    <p class="text-muted">No solution loaded yet. Enter a solution path above and click "Load solution".</p>
}
else
{
    var solution = State.Solution;
    var projects = solution.Projects;
    var sdkCount = projects.Count(p => p.Format == ProjectFormat.SdkStyle);
    var legacyCount = projects.Count(p => p.Format == ProjectFormat.LegacyStyle);
    var packagesConfigCount = projects.Count(p => p.Metadata.PackagesModel == PackagesModel.PackagesConfig);
    var tfmBreakdown = projects
        .Select(p => string.IsNullOrWhiteSpace(p.Metadata.TargetFrameworkRaw) ? "(unknown)" : p.Metadata.TargetFrameworkRaw)
        .GroupBy(tfm => tfm)
        .OrderByDescending(g => g.Count())
        .ThenBy(g => g.Key)
        .ToList();

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="display-6">@projects.Count</div>
                    <div class="text-muted">Projects</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="display-6">@sdkCount / @legacyCount</div>
                    <div class="text-muted">SDK-style / Legacy-style</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="display-6">@packagesConfigCount</div>
                    <div class="text-muted">Still on packages.config</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="display-6">@solution.NuGetSources.Count</div>
                    <div class="text-muted">NuGet sources</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">Target framework breakdown</div>
        <ul class="list-group list-group-flush">
            @foreach (var group in tfmBreakdown)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@group.Key</span>
                    <span class="badge bg-secondary rounded-pill">@group.Count()</span>
                </li>
            }
        </ul>
    </div>

    <p><a class="btn btn-outline-primary" href="/projects">Browse all projects &rarr;</a></p>

    <div class="card mb-4">
        <div class="card-header">Export</div>
        <div class="card-body">
            <p class="text-muted">
                Generate a shareable snapshot of this analysis. Each button (re)generates the file
                and immediately offers it for download.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick='() => ExportAsync("md")' disabled="@_exporting">Markdown summary</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick='() => ExportAsync("json")' disabled="@_exporting">JSON summary</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick='() => ExportAsync("dot")' disabled="@_exporting">Graph (DOT)</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick='() => ExportAsync("mmd")' disabled="@_exporting">Graph (Mermaid)</button>
            </div>
            @if (_downloadUri is not null)
            {
                <div class="mt-2">
                    <a class="btn btn-success btn-sm" href="@_downloadUri" download="@_downloadFileName">
                        Download @_downloadFileName
                    </a>
                </div>
            }
            @if (_exportError is not null)
            {
                <div class="alert alert-danger mt-2 mb-0">Export failed: @_exportError</div>
            }
        </div>
    </div>
}

@code {
    private string _solutionPath = "";
    private bool _exporting;
    private string? _downloadUri;
    private string? _downloadFileName;
    private string? _exportError;

    [Inject]
    private IReportExporter ReportExporter { get; set; } = default!;

    [Inject]
    private IGraphExporter GraphExporter { get; set; } = default!;

    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
    }

    private async Task LoadAsync() => await State.LoadSolutionAsync(_solutionPath);

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Runs the matching exporter to a temp file, reads it back, and exposes it as a base64 "data:"
    /// URI with a <c>download</c> attribute - the simplest way to hand the assessor a file from a
    /// Blazor Server page without a separate minimal-API download endpoint (which wouldn't share
    /// this circuit's DI scope/loaded solution anyway).
    /// </summary>
    private async Task ExportAsync(string extension)
    {
        if (State.Solution is null || State.Graph is null)
        {
            return;
        }

        _exporting = true;
        _exportError = null;
        _downloadUri = null;
        StateHasChanged();

        var tempPath = Path.Combine(Path.GetTempPath(), $"dotnetmodassess-export-{Guid.NewGuid():N}.{extension}");
        try
        {
            if (extension is "md" or "json")
            {
                await ReportExporter.ExportAsync(State.Solution, State.Graph, State.UsageResults ?? [], tempPath);
            }
            else
            {
                await GraphExporter.ExportAsync(State.Graph, tempPath);
            }

            var bytes = await File.ReadAllBytesAsync(tempPath);
            var mimeType = extension switch
            {
                "json" => "application/json",
                "dot" => "text/vnd.graphviz",
                "mmd" => "text/plain",
                _ => "text/markdown"
            };

            _downloadUri = $"data:{mimeType};base64,{Convert.ToBase64String(bytes)}";
            _downloadFileName = $"solution-{(extension is "md" or "json" ? "summary" : "graph")}.{extension}";
        }
        catch (Exception ex)
        {
            _exportError = ex.Message;
        }
        finally
        {
            if (File.Exists(tempPath))
            {
                File.Delete(tempPath);
            }

            _exporting = false;
            StateHasChanged();
        }
    }

    public void Dispose() => State.Changed -= OnStateChanged;
}
