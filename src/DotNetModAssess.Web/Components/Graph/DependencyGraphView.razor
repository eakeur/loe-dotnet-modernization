@implements IAsyncDisposable

<div class="dependency-graph-view">
    <div class="row g-2 mb-2">
        <div class="col-md-4">
            <input class="form-control" placeholder="Filter projects by name/path..."
                   @bind="_projectFilter" @bind:event="oninput" @bind:after="OnFilterChangedAsync" />
        </div>
        <div class="col-md-4">
            <input class="form-control" placeholder="Filter packages by id..."
                   @bind="_packageFilter" @bind:event="oninput" @bind:after="OnFilterChangedAsync" />
        </div>
        <div class="col-md-4">
            <select class="form-select" @bind="_tfmFilter" @bind:after="OnFilterChangedAsync">
                <option value="">Any target framework</option>
                @foreach (var tfm in _availableTfms)
                {
                    <option value="@tfm">@tfm</option>
                }
            </select>
        </div>
    </div>

    <div class="mb-2 d-flex flex-wrap align-items-center gap-3 small text-muted">
        <span><span class="legend-swatch legend-project"></span>Project</span>
        <span><span class="legend-swatch legend-package"></span>Package</span>
        <span><span class="legend-swatch legend-conflict"></span>Version conflict</span>
        <span>Click a node to highlight its dependency neighborhood. Click empty canvas to clear. Scroll/drag to zoom/pan.</span>
    </div>

    @if (Graph!.Nodes.Count > LargeGraphNodeThreshold)
    {
        <div class="alert alert-warning small mb-2">
            This graph has @Graph.Nodes.Count nodes. Cytoscape.js rendering and interaction (zoom/pan/click-to-focus)
            tends to get sluggish past a few hundred nodes - use the filters above to narrow it down to the
            projects/packages you care about. A "collapse to package-group" view is a known future mitigation for
            very large monorepos, not yet implemented.
        </div>
    }

    <div @ref="_containerRef" class="dependency-graph-canvas"></div>
</div>

@code {
    /// <summary>Known responsiveness limit for the underlying Cytoscape.js canvas (see spec's
    /// own "known limit" callout) - past this many nodes, rendering/interaction visibly degrades,
    /// so we surface a warning nudging the assessor toward the filters instead of pretending it
    /// scales indefinitely.</summary>
    private const int LargeGraphNodeThreshold = 400;

    /// <summary>The graph to render. Required - the component does not read from
    /// <c>SolutionStateService</c> itself so it stays reusable outside the "current solution"
    /// context (the <c>/graph</c> page is what wires it to <c>SolutionStateService</c>).</summary>
    [Parameter, EditorRequired]
    public DependencyGraph? Graph { get; set; }

    /// <summary>Optional - only used to populate the target-framework filter dropdown with the
    /// distinct <see cref="ProjectModel.TargetFrameworks"/> values across all loaded projects.</summary>
    [Parameter]
    public SolutionModel? Solution { get; set; }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private ElementReference _containerRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _graphApi;
    private DotNetObjectReference<DependencyGraphView>? _selfRef;
    private DependencyGraph? _initializedGraph;

    private string _projectFilter = "";
    private string _packageFilter = "";
    private string _tfmFilter = "";
    private List<string> _availableTfms = [];

    protected override void OnParametersSet()
    {
        _availableTfms = Solution?.Projects
            .SelectMany(p => p.TargetFrameworks)
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct()
            .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
            .ToList() ?? [];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Re-initialize whenever the *graph instance* handed to us changes (covers both the
        // first render and a fresh solution being loaded into the same still-mounted page),
        // but never re-run for unrelated re-renders of the same graph.
        if (Graph is not null && !ReferenceEquals(Graph, _initializedGraph))
        {
            await InitializeGraphAsync(Graph);
        }
    }

    private async Task InitializeGraphAsync(DependencyGraph graph)
    {
        await DisposeGraphApiAsync();

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dependencyGraph.js");

        var (nodes, edges) = BuildProjection(graph);
        _selfRef = DotNetObjectReference.Create(this);

        _graphApi = await _module.InvokeAsync<IJSObjectReference>("init", _containerRef, nodes, edges, _selfRef);

        _initializedGraph = graph;
        _projectFilter = "";
        _packageFilter = "";
        _tfmFilter = "";
    }

    /// <summary>
    /// Projects the domain graph into plain, JSON-serializable DTOs for the JS side. JS never
    /// touches <see cref="DotNetModAssess.Core.Graph.GraphNode"/>/<see cref="DotNetModAssess.Core.Models.PackageModel"/>
    /// etc. directly - only these shapes.
    /// </summary>
    private static (List<GraphNodeDto> Nodes, List<GraphEdgeDto> Edges) BuildProjection(DependencyGraph graph)
    {
        var nodes = graph.Nodes.Select(n => n switch
        {
            ProjectGraphNode p => new GraphNodeDto(
                Id: p.Id,
                Kind: "project",
                Label: p.Project.Name,
                HasVersionConflict: false,
                Tfms: p.Project.TargetFrameworks.ToArray()),
            PackageGraphNode pkg => new GraphNodeDto(
                Id: pkg.Id,
                Kind: "package",
                Label: pkg.Package.PackageId,
                HasVersionConflict: pkg.Package.HasVersionConflict,
                Tfms: []),
            _ => new GraphNodeDto(n.Id, n.Kind.ToString().ToLowerInvariant(), n.Id, false, [])
        }).ToList();

        var edges = graph.Edges
            .Select((e, index) => new GraphEdgeDto(
                Id: $"e{index}",
                Kind: e.Kind.ToString(),
                Source: e.FromId,
                Target: e.ToId))
            .ToList();

        return (nodes, edges);
    }

    /// <summary>
    /// Click-to-focus callback invoked from JS (<c>cy.on("tap", "node", ...)</c> in
    /// dependencyGraph.js). Highlights the clicked node's full <em>transitive</em> neighborhood
    /// (both <see cref="GraphDirection.Forward"/> dependencies and <see cref="GraphDirection.Reverse"/>
    /// dependents via <see cref="DependencyGraph.GetTransitiveClosure"/>) rather than only its
    /// direct neighbors, so an assessor can see a node's entire upstream/downstream footprint in
    /// one click.
    /// </summary>
    [JSInvokable]
    public async Task OnNodeClicked(string nodeId)
    {
        if (Graph is null || _graphApi is null)
        {
            return;
        }

        var node = Graph.Nodes.FirstOrDefault(n => n.Id == nodeId);
        if (node is null)
        {
            return;
        }

        var downstream = Graph.GetTransitiveClosure(node, GraphDirection.Forward);
        var upstream = Graph.GetTransitiveClosure(node, GraphDirection.Reverse);
        var neighborhoodIds = downstream.Select(n => n.Id)
            .Concat(upstream.Select(n => n.Id))
            .Distinct()
            .ToArray();

        await _graphApi.InvokeVoidAsync("highlight", nodeId, neighborhoodIds);
    }

    /// <summary>Clicking empty canvas clears the click-to-focus highlight (JS calls this from
    /// the core "tap" handler when the tap target is the cytoscape core itself, not an element).</summary>
    [JSInvokable]
    public async Task OnBackgroundClicked()
    {
        if (_graphApi is not null)
        {
            await _graphApi.InvokeVoidAsync("clearHighlight");
        }
    }

    private async Task OnFilterChangedAsync()
    {
        if (_graphApi is not null)
        {
            await _graphApi.InvokeVoidAsync("applyFilter", _projectFilter, _packageFilter, _tfmFilter);
        }
    }

    private async Task DisposeGraphApiAsync()
    {
        if (_graphApi is not null)
        {
            try
            {
                await _graphApi.InvokeVoidAsync("dispose");
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone (e.g. navigating away/tab closed) - nothing to clean up client-side.
            }

            await _graphApi.DisposeAsync();
            _graphApi = null;
        }

        _selfRef?.Dispose();
        _selfRef = null;
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeGraphApiAsync();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Same as above.
            }
        }
    }

    private sealed record GraphNodeDto(string Id, string Kind, string Label, bool HasVersionConflict, string[] Tfms);

    private sealed record GraphEdgeDto(string Id, string Kind, string Source, string Target);
}
