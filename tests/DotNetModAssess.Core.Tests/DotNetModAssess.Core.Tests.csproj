<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetModAssess.Core\DotNetModAssess.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UsageScanningFixtures/**/*.cs are inputs the RoslynUsageScanner tests feed to
         CSharpSyntaxTree.ParseText, not code compiled into this test assembly (some
         intentionally reference types that don't really exist, e.g. fully-qualified
         names used purely to exercise syntax-level matching). -->
    <Compile Remove="UsageScanningFixtures\**\*.cs" />
    <None Include="UsageScanningFixtures\**\*.cs" />
  </ItemGroup>

</Project>
